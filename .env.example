APP_PASSWORD=change-me
SESSION_SECRET=generate-with-openssl-rand-hex-32
FISZKI_DB=data/fiszki.db

# Google Cloud. Authentication is Application Default Credentials — there is no
# API key here and there must never be one. Locally, run:
#   gcloud auth application-default login
# On the VM, the attached service account is picked up automatically.
GOOGLE_CLOUD_PROJECT=
# Gemini on Vertex. 'global' is Google's recommended location.
GCP_VERTEX_LOCATION=global
# Speech-to-Text v2 and Text-to-Speech. Polish requires 'eu'.
GCP_SPEECH_LOCATION=eu
# Confirmed against `gcloud ai models list` in Task 9's probe step, not recalled.
FISZKI_MODEL=
